              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        <div className=\"rounded-3xl border border-neutral-200 bg-[#F5F5F5] p-6\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          <div className=\"flex items-center gap-2.5\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            <ShieldCheck className=\"h-5 w-5 text-[#101114]\" />"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            <h3 className=\"font-display text-lg font-bold text-[#101114]\">Transparent AI &amp; Risk Flags</h3>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          </div>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          <p className=\"mt-2 text-sm leading-relaxed text-[#777777]\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            MOVEX Guard analyses declared contents, mode regulations, and unusual booking patterns (such as rapid repeat bookings or prior rejections) for human review. It never claims AI can inspect the contents of an unopened parcel and never accuses users automatically."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
