    tool_calls {
      id: "call_8753338132556661873"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { useState } from \'react\';\\nimport { useNavigate, useSearchParams } from \'react-router-dom\';\\nimport { AlertCircle, CheckCircle2, Lock, Mail, Phone, User as UserIcon } from \'lucide-react\';\\nimport { useAuth } from \'../context/AuthContext\';\\nimport { getApiError } from \'../services/api\';\\nimport type { TransportMode } from \'../types/movex\';\\n\\nexport default function AuthPage() {\\n  const [searchParams] = useSearchParams();\\n  const intent = searchParams.get(\'intent\') === \'partner\' ? \'partner\' : \'sender\';\\n\\n  const { login, register } = useAuth();\\n  const navigate = useNavigate();\\n\\n  const [mode, setMode] = useState<\'login\' | \'register\'>(\'login\');\\n  const [email, setEmail] = useState(\'\');\\n  const [password, setPassword] = useState(\'\');\\n  const [name, setName] = useState(\'\');\\n  const [mobile, setMobile] = useState(\'\');\\n  const [role, setRole] = useState<\'sender\' | \'partner\'>(intent);\\n  const [primaryMode, setPrimaryMode] = useState<TransportMode>(\'bike\');\\n  const [vehicleNumber, setVehicleNumber] = useState(\'\');\\n  const [submitting, setSubmitting] = useState(false);\\n  const [error, setError] = useState(\'\');\\n\\n  const handleDemoFill = async (demoEmail: string) => {\\n    setError(\'\');\\n    setSubmitting(true);\\n    try {\\n      const u = await login(demoEmail, \'Movex@123\');\\n      if (u.role === \'admin\') navigate(\'/admin\');\\n      else if (u.role === \'partner\') navigate(\'/partner\');\\n      else navigate(intent === \'partner\' ? \'/partner\' : \'/sender\');\\n    } catch (err) {\\n      setError(getApiError(err));\\n    } finally {\\n      setSubmitting(false);\\n    }\\n  };\\n\\n  const handleSubmit = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    setError(\'\');\\n    setSubmitting(true);\\n\\n    try {\\n      if (mode === \'login\') {\\n        const u = await login(email, password);\\n        if (u.role === \'admin\') navigate(\'/admin\');\\n        else if (u.role === \'partner\') navigate(\'/partner\');\\n        else navigate(\'/sender\');\\n      } else {\\n        const u = await register({\\n          name,\\n          email,\\n          mobile,\\n          password,\\n          role,\\n          primaryMode: role === \'partner\' ? primaryMode : undefined,\\n          vehicleNumber: role === \'partner\' ? vehicleNumber : undefined\\n        });\\n        navigate(u.role === \'partner\' ? \'/partner\' : \'/sender\');\\n      }\\n    } catch (err) {\\n      setError(getApiError(err));\\n    } finally {\\n      setSubmitting(false);\\n    }\\n  };\\n\\n  return (\\n    <div className=\\\"mx-auto max-w-5xl px-4 py-10 sm:px-6\\\">\\n      <div className=\\\"grid grid-cols-1 gap-8 lg:grid-cols-12\\\">\\n        {/* Left Auth Card */}\\n        <div className=\\\"rounded-3xl border border-neutral-200 bg-white p-6 sm:p-8 lg:col-span-7\\\">\\n          <div className=\\\"flex items-center justify-between gap-4\\\">\\n            <div>\\n              <h1 className=\\\"font-display text-2xl font-extrabold text-[#101114]\\\">\\n                {mode === \'login\' ? \'Sign in to MOVEX\' : \'Create your MOVEX account\'}\\n              </h1>\\n              <p className=\\\"mt-1 text-sm text-[#777777]\\\">\\n                {mode === \'login\'\\n                  ? \'Access your bookings, journeys, and OTP handovers.\'\\n                  : \'You can switch between sending and delivering anytime.\'}\\n              </p>\\n            </div>\\n          </div>\\n\\n          {/* Mode Tabs */}\\n          <div className=\\\"mt-6 grid grid-cols-2 gap-1 rounded-xl bg-[#F5F5F5] p-1\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => {\\n                setMode(\'login\');\\n                setError(\'\');\\n              }}\\n              className={`h-10 rounded-lg text-sm font-semibold transition-colors ${\\n                mode === \'login\' ? \'bg-white text-[#101114] shadow-sm\' : \'text-[#777777] hover:text-[#101114]\'\\n              }`}\\n            >\\n              Login\\n            </button>\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => {\\n                setMode(\'register\');\\n                setError(\'\');\\n              }}\\n              className={`h-10 rounded-lg text-sm font-semibold transition-colors ${\\n                mode === \'register\' ? \'bg-white text-[#101114] shadow-sm\' : \'text-[#777777] hover:text-[#101114]\'\\n              }`}\\n            >\\n              Register\\n            </button>\\n          </div>\\n\\n          {error && (\\n            <div className=\\\"mt-4 flex items-center gap-2 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700\\\">\\n              <AlertCircle className=\\\"h-4 w-4 shrink-0\\\" />\\n              <span>{error}</span>\\n            </div>\\n          )}\\n\\n          <form onSubmit={handleSubmit} className=\\\"mt-5 space-y-4\\\">\\n            {mode === \'register\' && (\\n              <>\\n                <div>\\n                  <label className=\\\"mb-1.5 block text-xs font-semibold text-[#101114]\\\">Primary Activity</label>\\n                  <div className=\\\"grid grid-cols-2 gap-3\\\">\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={() => setRole(\'sender\')}\\n                      className={`rounded-xl border p-3 text-left transition-colors ${\\n                        role === \'sender\'\\n                          ? \'border-[#101114] bg-[#FFD43B]/25\'\\n                          : \'border-neutral-200 bg-[#F5F5F5]\'\\n                      }`}\\n                    >\\n                      <div className=\\\"text-sm font-bold text-[#101114]\\\">Send Parcels</div>\\n                      <div className=\\\"text-xs text-[#777777]\\\">Customer account</div>\\n                    </button>\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={() => setRole(\'partner\')}\\n                      className={`rounded-xl border p-3 text-left transition-colors ${\\n                        role === \'partner\'\\n                          ? \'border-[#101114] bg-[#FFD43B]/25\'\\n                          : \'border-neutral-200 bg-[#F5F5F5]\'\\n                      }`}\\n                    >\\n                      <div className=\\\"text-sm font-bold text-[#101114]\\\">Deliver Parcels</div>\\n                      <div className=\\\"text-xs text-[#777777]\\\">Partner account</div>\\n                    </button>\\n                  </div>\\n                </div>\\n\\n                <div>\\n                  <label className=\\\"mb-1.5 block text-xs font-semibold text-[#101114]\\\">Full Name</label>\\n                  <div className=\\\"relative\\\">\\n                    <UserIcon className=\\\"absolute top-1/2 left-3.5 h-4 w-4 -translate-y-1/2 text-[#777777]\\\" />\\n                    <input\\n                      type=\\\"text\\\"\\n                      required\\n                      value={name}\\n                      onChange={(e) => setName(e.target.value)}\\n                      placeholder=\\\"e.g. Rohan Dessai\\\"\\n                      className=\\\"h-11 w-full rounded-xl border border-neutral-200 bg-[#F5F5F5] pr-4 pl-10 text-sm text-[#101114] focus:border-[#101114] focus:bg-white focus:outline-none\\\"\\n                    />\\n                  </div>\\n                </div>\\n\\n                <div>\\n                  <label className=\\\"mb-1.5 block text-xs font-semibold text-[#101114]\\\">Mobile Number</label>\\n                  <div className=\\\"relative\\\">\\n                    <Phone className=\\\"absolute top-1/2 left-3.5 h-4 w-4 -translate-y-1/2 text-[#777777]\\\" />\\n                    <input\\n                      type=\\\"tel\\\"\\n                      required\\n                      value={mobile}\\n                      onChange={(e) => setMobile(e.target.value)}\\n                      placeholder=\\\"+91 98230 00000\\\"\\n                      className=\\\"h-11 w-full rounded-xl border border-neutral-200 bg-[#F5F5F5] pr-4 pl-10 text-sm text-[#101114] focus:border-[#101114] focus:bg-white focus:outline-none\\\"\\n                    />\\n                  </div>\\n                </div>\\n\\n                {role === \'partner\' && (\\n                  <div className=\\\"grid grid-cols-1 gap-3 sm:grid-cols-2\\\">\\n                    <div>\\n                      <label className=\\\"mb-1.5 block text-xs font-semibold text-[#101114]\\\">Primary Transport Mode</label>\\n                      <select\\n                        value={primaryMode}\\n                        onChange={(e) => setPrimaryMode(e.target.value as TransportMode)}\\n                        className=\\\"h-11 w-full rounded-xl border border-neutral-200 bg-[#F5F5F5] px-3 text-sm text-[#101114] focus:border-[#101114] focus:bg-white focus:outline-none\\\"\\n                      >\\n                        <option value=\\\"bike\\\">Bike</option>\\n                        <option value=\\\"car\\\">Car</option>\\n                        <option value=\\\"bus\\\">Bus</option>\\n                        <option value=\\\"train\\\">Train</option>\\n                        <option value=\\\"flight\\\">Flight</option>\\n                        <option value=\\\"freight\\\">Commercial Freight</option>\\n                      </select>\\n                    </div>\\n                    <div>\\n                      <label className=\\\"mb-1.5 block text-xs font-semibold text-[#101114]\\\">Vehicle / Pass Ref</label>\\n                      <input\\n                        type=\\\"text\\\"\\n                        value={vehicleNumber}\\n                        onChange={(e) => setVehicleNumber(e.target.value)}\\n                        placeholder=\\\"GA-07-X-1234\\\"\\n                        className=\\\"h-11 w-full rounded-xl border border-neutral-200 bg-[#F5F5F5] px-3 text-sm text-[#101114] focus:border-[#101114] focus:bg-white focus:outline-none\\\"\\n                      />\\n                    </div>\\n                  </div>\\n                )}\\n              </>\\n            )}\\n\\n            <div>\\n              <label className=\\\"mb-1.5 block text-xs font-semibold text-[#101114]\\\">Email Address</label>\\n              <div className=\\\"relative\\\">\\n                <Mail className=\\\"absolute top-1/2 left-3.5 h-4 w-4 -translate-y-1/2 text-[#777777]\\\" />\\n                <input\\n                  type=\\\"email\\\"\\n                  required\\n                  value={email}\\n                  onChange={(e) => setEmail(e.target.value)}\\n                  placeholder=\\\"you@example.com\\\"\\n                  className=\\\"h-11 w-full rounded-xl border border-neutral-200 bg-[#F5F5F5] pr-4 pl-10 text-sm text-[#101114] focus:border-[#101114] focus:bg-white focus:outline-none\\\"\\n                />\\n              </div>\\n            </div>\\n\\n            <div>\\n              <label className=\\\"mb-1.5 block text-xs font-semibold text-[#101114]\\\">Password</label>\\n              <div className=\\\"relative\\\">\\n                <Lock className=\\\"absolute top-1/2 left-3.5 h-4 w-4 -translate-y-1/2 text-[#777777]\\\" />\\n                <input\\n                  type=\\\"password\\\"\\n                  required\\n                  value={password}\\n                  onChange={(e) => setPassword(e.target.value)}\\n                  placeholder=\\\"Minimum 8 chars with letters & numbers\\\"\\n                  className=\\\"h-11 w-full rounded-xl border border-neutral-200 bg-[#F5F5F5] pr-4 pl-10 text-sm text-[#101114] focus:border-[#101114] focus:bg-white focus:outline-none\\\"\\n                />\\n              </div>\\n            </div>\\n\\n            <button\\n              type=\\\"submit\\\"\\n              disabled={submitting}\\n              className=\\\"mt-2 flex h-12 w-full items-center justify-center rounded-xl bg-[#FFD43B] text-sm font-bold text-[#101114] transition-colors hover:bg-[#F5C419] disabled:opacity-60\\\"\\n            >\\n              {submitting ? \'Please wait...\' : mode === \'login\' ? \'Sign In\' : \'Create Account\'}\\n            </button>\\n          </form>\\n        </div>\\n\\n        {/* Right Demo Accounts Panel */}\\n        <div className=\\\"rounded-3xl border border-neutral-200 bg-[#F5F5F5] p-6 sm:p-8 lg:col-span-5\\\">\\n          <h2 className=\\\"font-display text-lg font-bold text-[#101114]\\\">Demo Accounts for Testing</h2>\\n          <p className=\\\"mt-1 text-xs leading-relaxed text-[#777777]\\\">\\n            Use any verified prototype account below to test end-to-end Sender, Delivery Partner, or Administrator workflows immediately.\\n          </p>\\n\\n          <div className=\\\"mt-5 space-y-3\\\">\\n            <button\\n              type=\\\"button\\\"\\n              disabled={submitting}\\n              onClick={() => handleDemoFill(\'sender@movex.demo\')}\\n              className=\\\"w-full rounded-2xl border border-neutral-200 bg-white p-4 text-left transition-colors hover:border-[#101114]\\\"\\n            >\\n              <div className=\\\"flex items-center justify-between\\\">\\n                <span className=\\\"text-sm font-bold text-[#101114]\\\">Sender Demo (Aarav Naik)</span>\\n                <span className=\\\"rounded-lg bg-[#FFD43B] px-2.5 py-1 text-[11px] font-bold text-[#101114]\\\">\\n                  1-Click Login\\n                </span>\\n              </div>\\n              <div className=\\\"mt-1 font-mono-num text-xs text-[#777777]\\\">\\n                sender@movex.demo \302\267 Movex@123\\n              </div>\\n            </button>\\n\\n            <button\\n              type=\\\"button\\\"\\n              disabled={submitting}\\n              onClick={() => handleDemoFill(\'partner@movex.demo\')}\\n              className=\\\"w-full rounded-2xl border border-neutral-200 bg-white p-4 text-left transition-colors hover:border-[#101114]\\\"\\n            >\\n              <div className=\\\"flex items-center justify-between\\\">\\n                <span className=\\\"text-sm font-bold text-[#101114]\\\">Partner Demo (Rohan Dessai)</span>\\n                <span className=\\\"rounded-lg bg-[#101114] px-2.5 py-1 text-[11px] font-bold text-white\\\">\\n                  1-Click Login\\n                </span>\\n              </div>\\n              <div className=\\\"mt-1 font-mono-num text-xs text-[#777777]\\\">\\n                partner@movex.demo \302\267 Movex@123\\n              </div>\\n            </button>\\n\\n            <button\\n              type=\\\"button\\\"\\n              disabled={submitting}\\n              onClick={() => handleDemoFill(\'admin@movex.demo\')}\\n              className=\\\"w-full rounded-2xl border border-neutral-200 bg-white p-4 text-left transition-colors hover:border-[#101114]\\\"\\n            >\\n              <div className=\\\"flex items-center justify-between\\\">\\n                <span className=\\\"text-sm font-bold text-[#101114]\\\">Admin Demo (Neha Fernandes)</span>\\n                <span className=\\\"rounded-lg border border-neutral-300 bg-[#F5F5F5] px-2.5 py-1 text-[11px] font-bold text-[#101114]\\\">\\n                  1-Click Login\\n                </span>\\n              </div>\\n              <div className=\\\"mt-1 font-mono-num text-xs text-[#777777]\\\">\\n                admin@movex.demo \302\267 Movex@123\\n              </div>\\n            </button>\\n          </div>\\n\\n          <div className=\\\"mt-6 space-y-2 border-t border-neutral-200 pt-4 text-xs text-[#777777]\\\">\\n            <div className=\\\"flex items-center gap-2 text-[#101114]\\\">\\n              <CheckCircle2 className=\\\"h-4 w-4 shrink-0\\\" />\\n              <span>Senders can switch to Deliver mode anytime inside their dashboard.</span>\\n            </div>\\n            <div className=\\\"flex items-center gap-2 text-[#101114]\\\">\\n              <CheckCircle2 className=\\\"h-4 w-4 shrink-0\\\" />\\n              <span>Admin endpoints are strictly isolated by role-based JWT verification.</span>\\n            </div>\\n          </div>\\n        </div>\\n      </div>\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Create AuthPage with login, registration, password validation, and 1-click demo accounts in src/pages/AuthPage.tsx\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/AuthPage.tsx\", \"toolAction\":\"Creating AuthPage component\", \"toolSummary\":\"Create AuthPage component\"}"
