            lines {
              text: "function seedInitialData() {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const configCount = db.prepare(\'SELECT COUNT(*) as cnt FROM pricing_configs\').get() as { cnt: number };"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (configCount.cnt === 0) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    const insertCfg = db.prepare(`"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      INSERT INTO pricing_configs ("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        mode, display_name, base_fare, per_km_rate, per_kg_rate, volumetric_divisor,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        min_eta_mins, avg_speed_kmh, max_weight_kg, max_length_cm, max_width_cm, max_height_cm,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        integration_status, restrictions_summary, is_active"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, 1)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    `);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
