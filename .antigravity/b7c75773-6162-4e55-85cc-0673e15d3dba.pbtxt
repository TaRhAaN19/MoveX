              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      </div>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      <div className=\"mt-6 flex items-center gap-3 rounded-2xl border border-neutral-200 bg-white p-5\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
