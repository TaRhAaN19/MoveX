      thinking_signature: "\022\345\n\n\342\n\001i\024}\023\324\236\024\351~\354 i\264\341\376\243\000E\r*\316\312hR\2552\357\237\020\201\310\320?\320\323\217_V\nz[\207\356lcK\350\213\373\234\246E\305\031N*\233v!(_\302V\241\300E|\353\325~\334\016\177\223\267\366Sp[$\363\307\030*\254\233G\022\362\2016\215\325/55\324*\374\"3&\357_\bO\204\257jL\2372\024\2616\340\377\362\266\227\335-p\252\220\252\263\365D\372b-*\346\255nHM\223\331\310\313\277\346|~\347ru\030\251\017\220\357\264@6%\f\224.\362\373h=\n\314\'c[+F\252\036\a\v\206\235e\331\"\034\3508\271\305\017\356~\360\367\331\034\2427\337d\250{\032\372\243`\225=\344\006\373I7h\307v\253\345\016`\223G\235\371\022}\024R\327;\021\357V\b2\bZ\f\002\372\a\303\004\031\302\026\3335\337Pv\004\220}\374t\313S:\306\351\321\365\331.\233\023\230\n\252\255?\"+\nS\267\234\217\323\321\355LK\212\327\267U\257@\031\033@\341U;\275+\355+\374\026#\305\312\311\373\211\272\347tX\237\257\316 [\220:\371\211D\342b#\302\222\177gQ\217\000\n\300\240\345?\301\263\r\023\321\0225\363\f\370\227Q-\365\227_\033\264R/>\272\240\231\311\272\n\301\371n\237\365`\350\371\311\212\004\340\206<\334\177\377aZ\233\222\201\a+\2077\221\326,\304\267\364\342\304\032\345\323\327\201\340A\301\367\001y\0248,\304\022\320M\200\036\250\206\264*\205\206\202\byr?\314\272\265r\347\022\207Z\017\243\211\243\177\021\022\331\300R\277.\220V\r\"L\310\334\006\233\3215\213\fk\234\027\000\353\363\355\034W\311\034\263{\271\357YHj\260\031^\\\346\305B\302\264\006\370:j\000\2322r\322\321\3435\036E\'\r](\261\032\356\263\222\324*\353y?*Z\024\263\265\375,\032-\316\256\254\3409EM\027\340,1\225\261\by\247\261\333\323\363\272\367}\0327\aj_\036\311r\216\202\364\33511.\314:\332\261\230\245\317\344\020m\030Eq\2254b\275VCg\333\326;\2621\005\2330\266R\032\201jE\364\021\362\340\376[Q\313<\346\341~\243\365\020a\027\251\235:\314\240O#\202D\242Z\306$\2251\275u\031\215\223\201\323T\017\034\202\252\222\315\256\240\303\216\311D\226GN\270\336\344D\300\2758\227\373n\326\215\204i\200\251\341w,j\313\023\341\242o\346b\324\365\212\315\036\357\320u\314\f\337}?\335\023\220\351U\323\315_\211Id&\344=\016\234-N\257$z\345x\236g\325H\036Nf\316)\341J<\261\2046E\244s\026\206uG\371\332Nn\031\254\250\020i\367\304\372)\230\'\224\347$\272\303\337\004<\205\375\351\371\313Sk\240\324\350\333\250o\t!\240\232\322\020f\265\222\206\024BU\362\026?\220\324a\355\'\376e\372\360r\221\303\211\362\335\232\201\345\306\350\201\201\224\035\234\004\267^!5\024.!!gD\201\203\363\367=oo\257\006Tt\260\023&\020\207\356\237\232\\\2034%\036\326\034S\212\267\241xJ^\030Kl\205\346VHi\262R\217\"\355U\026\177\323\245\375\266\003\313\306\3704m\245\323\322O\032\t\225QxSK\243p\016 \370\310f\274\003\210\261\n\354\272\327\355U\264\271y\305!\a\206\364$\2210\2027v\314\272}\272\001&A\273\364\337\316\354(h\002i\ft\023\211\005\001mw\246\362\232\022I=\016\f\211f*]\245\246\321\235|\316\221\254\337B\230\360\306\252~\372s\206*}H\352\244}\204a$\361\t\245\317\206\355To\322\203U\200O*\215\025\257 \035Z\350\357\314A\377/\227r\222A+C\276y\223\364\220\312\363\375\272\213\"-*\342\243N\356\212\030\245L\342\341\f\257\304\324\255>\024\242\315\274I?~\\\212\\\222\375\035\250kJV^\2726/\276J&\000\250\322\270\362U\'\3049,\256@<\334$\257\247\265\034\302\244\245\2416\270\024\340i\004zl\243&\361\275I\300\264-\371\351\237\353SH\363\265\347\215=\364\003n\367\373\026\222Ft\246\aZ$+\225\003\031\230c\215\016\020\341\234\325\212y\3431\336\266n\354\037\224\343|v\t[\210k\272=b\2260:3C\315\031\030\322\224\220\357\232\006\237P\307EzL\351\300{\273\326\215\336OJ\302\236M$\365\307\306x]&\300Q\033\t\262:\271b\207Jy.\334\215\274\336q\241_C\241\311Zw\275\037d\271\223<\256@\364V\355g3\332\243\202R\3246o|\024C\227\313\300\034\032\260a\'b\256\322\030\004o%\363:kj\222\346\016\2476\0344\361\214\231\264Q\301g\212\356)Td\246\367\260\004\371\322\274\313\203P\262\357\251\020F&U\243\310\363\234]@>k\207`OC\313\311 \341\370\265qd61\252\302\253\vKj\020\256\205\345\320\304\202$8\310\242\334\277\003\2557\344\360\026mmj\241\223^\350\310\247\200\030;2x\341*\307\\\247\n\307\037"
