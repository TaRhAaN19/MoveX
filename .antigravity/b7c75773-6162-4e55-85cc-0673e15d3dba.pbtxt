      arguments_json: "{\"CodeContent\":\"import { useState } from \'react\';\\nimport { useNavigate } from \'react-router-dom\';\\nimport { ArrowRight, Package, Navigation, Search, ShieldCheck, Route, Clock } from \'lucide-react\';\\nimport { useAuth } from \'../context/AuthContext\';\\nimport { TransportModeIcon } from \'../components/TransportIcon\';\\n\\nconst MODES = [\\n  { mode: \'bike\', name: \'Bike\', start: \'\342\202\27130\', desc: \'Fast local & short corridors up to 5 kg\' },\\n  { mode: \'car\', name: \'Car\', start: \'\342\202\27150\', desc: \'Flexible regional trips up to 15 kg\' },\\n  { mode: \'bus\', name: \'Bus\', start: \'\342\202\27140\', desc: \'Intercity coach luggage relay\' },\\n  { mode: \'train\', name: \'Train\', start: \'\342\202\27160\', desc: \'Station-to-station rail corridors\' },\\n  { mode: \'flight\', name: \'Flight\', start: \'\342\202\271150\', desc: \'Priority intercity air cargo workflow\' },\\n  { mode: \'freight\', name: \'Commercial Freight\', start: \'\342\202\271100\', desc: \'Volumetric & heavier consignments\' }\\n] as const;\\n\\nexport default function LandingPage() {\\n  const { user, switchActivity } = useAuth();\\n  const navigate = useNavigate();\\n  const [trackCode, setTrackCode] = useState(\'\');\\n\\n  const handleSelectSend = async () => {\\n    if (user) {\\n      if (user.role === \'admin\') {\\n        navigate(\'/admin\');\\n        return;\\n      }\\n      await switchActivity(\'sender\');\\n      navigate(\'/sender?tab=book\');\\n    } else {\\n      navigate(\'/auth?intent=sender\');\\n    }\\n  };\\n\\n  const handleSelectDeliver = async () => {\\n    if (user) {\\n      if (user.role === \'admin\') {\\n        navigate(\'/admin\');\\n        return;\\n      }\\n      await switchActivity(\'partner\');\\n      navigate(\'/partner\');\\n    } else {\\n      navigate(\'/auth?intent=partner\');\\n    }\\n  };\\n\\n  const handleTrackSubmit = (e: React.FormEvent) => {\\n    e.preventDefault();\\n    const cleaned = trackCode.trim();\\n    if (!cleaned) return;\\n    navigate(`/track/${encodeURIComponent(cleaned)}`);\\n  };\\n\\n  return (\\n    <main className=\\\"bg-white\\\">\\n      {/* Opening Screen \342\200\224 User Activity Selection */}\\n      <section className=\\\"mx-auto max-w-6xl px-4 pt-10 pb-12 sm:px-6 md:pt-14 md:pb-16\\\">\\n        <div className=\\\"max-w-3xl\\\">\\n          <p className=\\\"text-xs font-bold tracking-widest text-[#777777] uppercase\\\">\\n            MOVEX \342\200\224 Moving Things Together\\n          </p>\\n          <h1 className=\\\"font-display mt-3 text-3xl font-extrabold tracking-tight text-[#101114] text-balance sm:text-5xl\\\">\\n            What would you like to do today?\\n          </h1>\\n          <p className=\\\"mt-3 text-base text-[#777777] sm:text-lg\\\">\\n            Choose to send a parcel with travellers already heading your way, or share your existing journey to earn.\\n          </p>\\n        </div>\\n\\n        {/* Two Large Selectable Cards */}\\n        <div className=\\\"mt-8 grid grid-cols-1 gap-5 md:grid-cols-2\\\">\\n          <button\\n            type=\\\"button\\\"\\n            onClick={handleSelectSend}\\n            className=\\\"group flex flex-col justify-between rounded-3xl border border-neutral-200 bg-[#F5F5F5] p-6 text-left transition-all duration-150 hover:border-[#101114] hover:bg-white hover:shadow-lg sm:p-8\\\"\\n          >\\n            <div>\\n              <div className=\\\"flex items-center justify-between\\\">\\n                <div className=\\\"flex h-14 w-14 items-center justify-center rounded-2xl bg-[#FFD43B] text-[#101114]\\\">\\n                  <Package className=\\\"h-7 w-7\\\" />\\n                </div>\\n                <span className=\\\"inline-flex h-10 w-10 items-center justify-center rounded-full bg-white text-[#101114] transition-transform group-hover:translate-x-1\\\">\\n                  <ArrowRight className=\\\"h-5 w-5\\\" />\\n                </span>\\n              </div>\\n              <h2 className=\\\"font-display mt-6 text-2xl font-extrabold text-[#101114]\\\">\\n                Send a Parcel\\n              </h2>\\n              <p className=\\\"mt-1 text-sm font-semibold text-[#101114]\\\">\\n                Send anything, anywhere.\\n              </p>\\n              <p className=\\\"mt-2 text-sm leading-relaxed text-[#777777]\\\">\\n                Book a convenient and affordable parcel delivery via Community Relay or doorstep Premium Express.\\n              </p>\\n            </div>\\n            <div className=\\\"mt-6 flex items-center justify-between border-t border-neutral-200/80 pt-4\\\">\\n              <span className=\\\"text-xs font-medium text-[#777777]\\\">\\n                6 Transport Modes \302\267 Dynamic INR Pricing\\n              </span>\\n              <span className=\\\"rounded-xl bg-[#FFD43B] px-4 py-2 text-xs font-bold text-[#101114]\\\">\\n                Book Delivery\\n              </span>\\n            </div>\\n          </button>\\n\\n          <button\\n            type=\\\"button\\\"\\n            onClick={handleSelectDeliver}\\n            className=\\\"group flex flex-col justify-between rounded-3xl border border-[#101114] bg-[#101114] p-6 text-left text-white transition-all duration-150 hover:bg-[#25282D] hover:shadow-lg sm:p-8\\\"\\n          >\\n            <div>\\n              <div className=\\\"flex items-center justify-between\\\">\\n                <div className=\\\"flex h-14 w-14 items-center justify-center rounded-2xl bg-[#FFD43B] text-[#101114]\\\">\\n                  <Navigation className=\\\"h-7 w-7\\\" />\\n                </div>\\n                <span className=\\\"inline-flex h-10 w-10 items-center justify-center rounded-full bg-[#25282D] text-white transition-transform group-hover:translate-x-1\\\">\\n                  <ArrowRight className=\\\"h-5 w-5\\\" />\\n                </span>\\n              </div>\\n              <h2 className=\\\"font-display mt-6 text-2xl font-extrabold text-white\\\">\\n                Deliver a Parcel\\n              </h2>\\n              <p className=\\\"mt-1 text-sm font-semibold text-[#FFD43B]\\\">\\n                Earn while you&apos;re on the move.\\n              </p>\\n              <p className=\\\"mt-2 text-sm leading-relaxed text-neutral-300\\\">\\n                Share your existing journey and earn money carrying parcels along routes you already travel.\\n              </p>\\n            </div>\\n            <div className=\\\"mt-6 flex items-center justify-between border-t border-white/15 pt-4\\\">\\n              <span className=\\\"text-xs font-medium text-neutral-300\\\">\\n                Existing Journeys \302\267 Verified OTP Handovers\\n              </span>\\n              <span className=\\\"rounded-xl bg-[#FFD43B] px-4 py-2 text-xs font-bold text-[#101114]\\\">\\n                Share Journey\\n              </span>\\n            </div>\\n          </button>\\n        </div>\\n\\n        {/* Instant Parcel Tracking Bar */}\\n        <form\\n          onSubmit={handleTrackSubmit}\\n          className=\\\"mt-8 flex flex-col gap-3 rounded-2xl border border-neutral-200 bg-[#F5F5F5] p-4 sm:flex-row sm:items-center sm:p-5\\\"\\n        >\\n          <div className=\\\"flex items-center gap-3 sm:min-w-[220px]\\\">\\n            <Search className=\\\"h-5 w-5 shrink-0 text-[#101114]\\\" />\\n            <div>\\n              <div className=\\\"text-sm font-bold text-[#101114]\\\">Track a Parcel</div>\\n              <div className=\\\"text-xs text-[#777777]\\\">Try MVX-2026-1001 or MVX-2026-1002</div>\\n            </div>\\n          </div>\\n          <div className=\\\"flex flex-1 gap-2\\\">\\n            <input\\n              type=\\\"text\\\"\\n              value={trackCode}\\n              onChange={(e) => setTrackCode(e.target.value)}\\n              placeholder=\\\"Enter Parcel ID (e.g. MVX-2026-1001)\\\"\\n              className=\\\"h-11 flex-1 rounded-xl border border-neutral-200 bg-white px-4 font-mono-num text-sm text-[#101114] placeholder-[#777777] focus:border-[#101114] focus:outline-none\\\"\\n            />\\n            <button\\n              type=\\\"submit\\\"\\n              className=\\\"h-11 rounded-xl bg-[#101114] px-5 text-sm font-semibold text-white transition-colors hover:bg-[#25282D] whitespace-nowrap shrink-0\\\"\\n            >\\n              Track Now\\n            </button>\\n          </div>\\n        </form>\\n      </section>\\n\\n      {/* Two Delivery Models Comparison */}\\n      <section className=\\\"border-t border-neutral-200 bg-[#F5F5F5] py-12\\\">\\n        <div className=\\\"mx-auto max-w-6xl px-4 sm:px-6\\\">\\n          <div className=\\\"flex flex-col justify-between gap-4 md:flex-row md:items-end\\\">\\n            <div>\\n              <h2 className=\\\"font-display text-2xl font-bold text-[#101114]\\\">\\n                Two Flexible Delivery Models\\n              </h2>\\n              <p className=\\\"mt-1 text-sm text-[#777777]\\\">\\n                Switch seamlessly between affordable route-matched relays and dedicated doorstep express.\\n              </p>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"mt-6 grid grid-cols-1 gap-5 md:grid-cols-2\\\">\\n            <div className=\\\"rounded-2xl border border-neutral-200 bg-white p-6\\\">\\n              <div className=\\\"flex items-center justify-between\\\">\\n                <h3 className=\\\"font-display text-lg font-bold text-[#101114]\\\">Community Relay</h3>\\n                <span className=\\\"font-mono-num text-xs font-bold text-[#101114]\\\">Zero Dedicated Trips</span>\\n              </div>\\n              <p className=\\\"mt-2 text-sm text-[#777777]\\\">\\n                Matches your parcel with verified individuals already travelling on that route. AI suggests safe public meeting points for sender and partner agreement.\\n              </p>\\n              <div className=\\\"mt-4 flex flex-wrap gap-x-4 gap-y-1 text-xs font-medium text-[#101114]\\\">\\n                <span>Lowest delivery charges</span>\\n                <span aria-hidden=\\\"true\\\">\302\267</span>\\n                <span>AI route compatibility</span>\\n                <span aria-hidden=\\\"true\\\">\302\267</span>\\n                <span>Existing journeys only</span>\\n              </div>\\n            </div>\\n\\n            <div className=\\\"rounded-2xl border border-neutral-200 bg-white p-6\\\">\\n              <div className=\\\"flex items-center justify-between\\\">\\n                <h3 className=\\\"font-display text-lg font-bold text-[#101114]\\\">Premium Express</h3>\\n                <span className=\\\"font-mono-num text-xs font-bold text-[#101114]\\\">Doorstep to Doorstep</span>\\n              </div>\\n              <p className=\\\"mt-2 text-sm text-[#777777]\\\">\\n                Assigns a dedicated verified delivery partner for direct collection from your doorstep and fast delivery to the recipient&apos;s door.\\n              </p>\\n              <div className=\\\"mt-4 flex flex-wrap gap-x-4 gap-y-1 text-xs font-medium text-[#101114]\\\">\\n                <span>Direct dispatch</span>\\n                <span aria-hidden=\\\"true\\\">\302\267</span>\\n                <span>Priority ETAs</span>\\n                <span aria-hidden=\\\"true\\\">\302\267</span>\\n                <span>OTP verified custody</span>\\n              </div>\\n            </div>\\n          </div>\\n        </div>\\n      </section>\\n\\n      {/* Six Transportation Modes */}\\n      <section className=\\\"py-12\\\">\\n        <div className=\\\"mx-auto max-w-6xl px-4 sm:px-6\\\">\\n          <h2 className=\\\"font-display text-2xl font-bold text-[#101114]\\\">\\n            Six Transportation Modes\\n          </h2>\\n          <p className=\\\"mt-1 text-sm text-[#777777]\\\">\\n            Real-time compatibility and dynamic pricing across local, regional, and intercity modes.\\n          </p>\\n\\n          <div className=\\\"mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3\\\">\\n            {MODES.map((m) => (\\n              <div\\n                key={m.mode}\\n                className=\\\"flex items-start gap-4 rounded-2xl border border-neutral-200 bg-white p-5 transition-colors hover:border-[#101114]\\\"\\n              >\\n                <div className=\\\"flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[#F5F5F5] text-[#101114]\\\">\\n                  <TransportModeIcon mode={m.mode} />\\n                </div>\\n                <div className=\\\"min-w-0 flex-1\\\">\\n                  <div className=\\\"flex items-center justify-between gap-2\\\">\\n                    <h3 className=\\\"font-display text-base font-bold text-[#101114]\\\">{m.name}</h3>\\n                    <span className=\\\"font-mono-num text-xs font-bold text-[#101114]\\\">From {m.start}</span>\\n                  </div>\\n                  <p className=\\\"mt-1 text-xs leading-relaxed text-[#777777]\\\">{m.desc}</p>\\n                </div>\\n              </div>\\n            ))}\\n          </div>\\n        </div>\\n      </section>\\n\\n      {/* Trust & Intelligence Strip */}\\n      <section className=\\\"border-t border-neutral-200 bg-[#F5F5F5] py-10\\\">\\n        <div className=\\\"mx-auto grid max-w-6xl grid-cols-1 gap-6 px-4 sm:px-6 md:grid-cols-3\\\">\\n          <div className=\\\"flex items-start gap-3\\\">\\n            <Route className=\\\"mt-0.5 h-5 w-5 shrink-0 text-[#101114]\\\" />\\n            <div>\\n              <h3 className=\\\"text-sm font-bold text-[#101114]\\\">MOVEX Intelligence</h3>\\n              <p className=\\\"mt-1 text-xs text-[#777777]\\\">\\n                Scores existing journeys out of 100, predicts ETAs, and suggests public meeting hubs.\\n              </p>\\n            </div>\\n          </div>\\n          <div className=\\\"flex items-start gap-3\\\">\\n            <ShieldCheck className=\\\"mt-0.5 h-5 w-5 shrink-0 text-[#101114]\\\" />\\n            <div>\\n              <h3 className=\\\"text-sm font-bold text-[#101114]\\\">MOVEX Guard</h3>\\n              <p className=\\\"mt-1 text-xs text-[#777777]\\\">\\n                Screens declarations against transport regulations while supporting normal paper and cardboard packaging.\\n              </p>\\n            </div>\\n          </div>\\n          <div className=\\\"flex items-start gap-3\\\">\\n            <Clock className=\\\"mt-0.5 h-5 w-5 shrink-0 text-[#101114]\\\" />\\n            <div>\\n              <h3 className=\\\"text-sm font-bold text-[#101114]\\\">OTP Custody Timeline</h3>\\n              <p className=\\\"mt-1 text-xs text-[#777777]\\\">\\n                Digital parcel QR identity with Pickup, Relay Handover, and Recipient Delivery OTP verification.\\n              </p>\\n            </div>\\n          </div>\\n        </div>\\n      </section>\\n    </main>\\n  );\\n}\\n\", \"Description\":\"Create Rapido-inspired Opening Screen with Send/Deliver activity selection, parcel tracker, and modes overview in src/pages/LandingPage.tsx\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/LandingPage.tsx\", \"toolAction\":\"Creating LandingPage opening screen\", \"toolSummary\":\"Create LandingPage opening screen\"}"
      original_name: "write_to_file"
