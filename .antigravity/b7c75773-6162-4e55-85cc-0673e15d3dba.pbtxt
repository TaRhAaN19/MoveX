      thinking_signature: "\022\332\030\n\327\030\001i\024}\023\324ba1\374!\213\353\005\300\231\373\006S\271Q?\206\372B\362zk\2417\203R\220\303j\023!dwQ\031S\267%w\305\212\247\256\321*\303\200\001\002\fo$\363\201r_W\361{O\316\030\f#\3071l\3705\267\215\375UC\032\307\v5\030:\220\271\271\377\223\3237\220\246\211NQ_:\005\020D\352\364AGAX\300\226\315\367\217\276\367\234\b\264\004\242\376\2224d0\333\327,\327r\321\260t\031\204\2066\244\225B\024\236\264\372\310\250\327\016\337\036r\326B\003*w&hZ%\2671\350\312a\020\023\235\202\373\335Y!\000 &\3131M\276\327\375\316\276\250\001\222\206\347\002Z\002\363\272Pk\016\353\367\320\200\203-QXh\213\231\330\nx\372\323\230(Y0,\2774\203\357\v\215DGH\265\350\rum\370o\206\3505C\372:\234\017\0303\224\215\327(\362\236>\247W\0337A\262pN\277z0Wi\273\2177{\250\262\241k\266\265\317M3G\314\361.\305<\250\352\033\216N\376?\217\271\236\210\323\033y\346\215\227\240\372\352\355\2276\251v\024\212,8\310\033\362q@\205\344\221\363{^\252s\347C\312\236\306=7\301\253\363\340\223\271\242f\277J\005\\r^\236\251\033J\037*\211h>.\370u\245\317\275\252\335H$4P\244{_;\316.Q\204\354\027{\377\245\262\204!\030\3065\210\f\264|F\272H_\257@\214\333\n1S\037:m\021k\017\305)\316?\265]\266^\247\300\377\004\023\3235\334\000C\230\037\326dR(\246\251\350\333\026\311g\336\350&ro\307\354*\325\200\325\220&\237\247\363\t%3nWW\b+\305\035\225\275\344MX\231\356n\371FO\351q\216\214\334\363\005\020.\a\b?T\267\376\202-\323\2718P\3511\363\215\332>\272\236\376xL\332n\200Ja\\\031\344\241\035\347\252B\373R\025%[M\353sK\342.5\333\000\300\017\233m\323\344\225\345\020\276\260\357m\335\322U\310h\rts\2523fuAY\016\307\236\221u\262\'\325\330\351JH\v2a>\230\323\376<\272m!\\h\334\206\247\025\337{\b\354Q\226\201U\320\266\355^\326\247v\252%\a\206\355\231F\216?\232\\E\360\360o\035U\210\006>u+E\006\301\212\264Y=X=0\350b\334F\a\272\202\260\020\255\023\220\371\an\264\310[\3672\201\232\213y\320\1771\v;\316FW\277\355\3666\356\300\227\001N\\m\311\341\266\373B\242\232Ec\366\347\305\023\'#\001\230\323\032\005\033N\203,\304\357\250H\300\345<\343l\177\356\323\211\216^\354\277\237\355\016\236\273q\302@D\203Z\264\v\367\fSg\212\357\240\200\220\361\365\2443hp\206g\373\262\005\0339\272\230b\216\262\327\267\244\303\'^\315H\247\035Oj\3650\262\347\211\240*\273\022\252p\177\275\347\t7\363\037\023\247d`\020\222\0025\231\337\n\333\312rb\3224\361m\201t\025su\n\350\252\244\000\260\023\215wQ\322\332\342M\230\357\3030\3500d\310j\226i\f\334v\003\020\317\342%\304\002W\3437H\261\303`\201\020\366\205\221\017\350\323|\361`\201q\346$.\337\234u\315\232\356\307\260\232\225\023\262\370\226?\37554\312\310.\033\211\311oS\267\304\246m\263\vA\002\260\032\263\004\362\356\376k\037\265\260\363\335\003\212\340\225\177\016\272\034\004z\317P\036\251:#1\025\207\206-\002.\246\345_\260\'\215Z\t\246\020K\363\275\255p\307mbg\216\221\016\344\236\\l\267.\006\247\227\225\314\354\266Fw<\337\204\262\260\327\320\251\034y\271\036\0022b\215 ;\242W\377\001\323\316\022\243J\2720\002\214\210F\224\233x\334\257\326\373\375$\377\311\022\3209\267u\225m\324\342\214Z\331\207\250\345\024\a\024\260\322\353\"\370*\006\366KC]8\362u!\032m:\232Oy\2708\016omZ\334\315*\257\002Z\376\363\016\220\201~\350\370\306\336V\fp\345#U\267\006\206\341g\200\335\206\272Nh\357v\276\v\277c\232\033\252\233p\346AiM\033\027\327\234\v\316\023\271\35164\363\215N\372\210M0\fc\036c\fM\204\036\370k\206Xu?\211kSS\360J\363\024\317-\202M\355s6\246\t\005F\205\000\002\213T\373hu\246\357\342\025\345\2464\340\027\350\341\"\376\261\350exe\265h\236\232A\037\230\005\272\330\360dsD{\313\305I\273W\214\361\2471K*\342\362g;\265\262V\370]\247\342\005\274\356\353\244\021\222f2\320\340\321 \363^\307A\006\304\365q\263\361vO\345s\375\322\303=\313\204i\373\315\021\354\306\021\225\300,\324$\313i\215D\230F \306\361\233BC\231\272\337\367i7\020\320\355\215[]\204S\021{ie\\\020\353x\225\222\276_aA\371\253\357\224\260\226\315\n5\342\252\t\255P\320r<e\227\312\315\256\245}v\025]G\354\002]\002\234\v\021\224\305\237w\267\211\200\340\275\370\232\336\375I\020\256\002\027\030\244\362\032\265~\fH\