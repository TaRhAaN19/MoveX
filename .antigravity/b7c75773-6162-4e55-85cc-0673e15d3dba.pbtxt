  code_action {
    action_spec {
      create_file {
        instruction: "import { AlertTriangle, CheckCircle2, Lock, PackageCheck, ShieldAlert, ShieldCheck } from \'lucide-react\';\n\nexport default function SafetyPage() {\n  return (\n    <div className=\"mx-auto max-w-6xl px-4 py-10 sm:px-6\">\n      <div className=\"max-w-3xl\">\n        <h1 className=\"font-display text-3xl font-extrabold text-[#101114] sm:text-4xl\">\n          MOVEX Guard &amp; Parcel Safety\n        </h1>\n        <p className=\"mt-3 text-base text-[#777777]\">\n          Every parcel passes through transparent declaration screening, mode-specific operator checks, and OTP-verified handovers\342\200\224without requiring special seals, branded boxes, or inspection centres.\n        </p>\n      </div>\n\n      <div className=\"mt-8 grid grid-cols-1 gap-5 md:grid-cols-3\">\n        <div className=\"rounded-2xl border border-neutral-200 bg-white p-6\">\n          <div className=\"flex items-center gap-2.5 text-emerald-700\">\n            <CheckCircle2 className=\"h-5 w-5\" />\n            <h2 className=\"font-display text-lg font-bold text-[#101114]\">PERMITTED</h2>\n          </div>\n          <p className=\"mt-2 text-sm text-[#777777]\">\n            Ordinary documents, books, apparel, packaged dry food, gifts, and household goods under 15 kg. Cleared immediately after sender declaration.\n          </p>\n        </div>\n\n        <div className=\"rounded-2xl border border-neutral-200 bg-white p-6\">\n          <div className=\"flex items-center gap-2.5 text-amber-700\">\n            <AlertTriangle className=\"h-5 w-5\" />\n            <h2 className=\"font-display text-lg font-bold text-[#101114]\">RESTRICTED</h2>\n          </div>\n          <p className=\"mt-2 text-sm text-[#777777]\">\n            High-value electronics (&gt;\342\202\27125,000), lithium batteries on air routes, fragile glass, or liquids. Routed to MOVEX Guard manual admin verification.\n          </p>\n        </div>\n\n        <div className=\"rounded-2xl border border-neutral-200 bg-white p-6\">\n          <div className=\"flex items-center gap-2.5 text-red-700\">\n            <ShieldAlert className=\"h-5 w-5\" />\n            <h2 className=\"font-display text-lg font-bold text-[#101114]\">PROHIBITED</h2>\n          </div>\n          <p className=\"mt-2 text-sm text-[#777777]\">\n            Explosives, weapons, narcotics, flammable fuels, corrosive chemicals, and items forbidden by law or transport operators. Blocked automatically.\n          </p>\n        </div>\n      </div>\n\n      <div className=\"mt-8 grid grid-cols-1 gap-6 md:grid-cols-2\">\n        <div className=\"rounded-3xl border border-neutral-200 bg-[#F5F5F5] p-6\">\n          <div className=\"flex items-center gap-2.5\">\n            <PackageCheck className=\"h-5 w-5 text-[#101114]\" />\n            <h3 className=\"font-display text-lg font-bold text-[#101114]\">Normal Packaging Supported</h3>\n          </div>\n          <p className=\"mt-2 text-sm leading-relaxed text-[#777777]\">\n            Senders can use ordinary envelopes, paper wrapping, cloth bags, or standard cardboard boxes. MOVEX never forces proprietary packaging, physical QR stickers, special tamper seals, or mandatory central inspection hubs.\n          </p>\n        </div>\n\n        <div className=\"rounded-3xl border border-neutral-200 bg-[#F5F5F5] p-6\">\n          <div className=\"flex items-center gap-2.5\">\n            <ShieldCheck className=\"h-5 w-5 text-[#101114]\" />\n            <h3 className=\"font-display text-lg font-bold text-[#101114]\">Transparent AI &amp; Risk Flags</h3>\n          </div>\n          <p className=\"mt-2 text-sm leading-relaxed text-[#777777]\">\n            MOVEX Guard analyses declared contents, mode regulations, and unusual booking patterns (such as rapid repeat bookings or prior rejections) for human review. It never claims AI can inspect the contents of an unopened parcel and never accuses users automatically.\n          </p>\n        </div>\n      </div>\n\n      <div className=\"mt-6 flex items-center gap-3 rounded-2xl border border-neutral-200 bg-white p-5\">\n        <Lock className=\"h-5 w-5 shrink-0 text-[#101114]\" />\n        <p className=\"text-sm text-[#777777]\">\n          Every active delivery uses three distinct OTPs\342\200\224<strong className=\"text-[#101114]\">Pickup OTP</strong>, <strong className=\"text-[#101114]\">Relay Handover OTP</strong>, and <strong className=\"text-[#101114]\">Recipient Delivery OTP</strong>\342\200\224recorded in a timestamped custody ledger.\n        </p>\n      </div>\n    </div>\n  );\n}\n"
        path {
          absolute_uri: "file:///src/pages/SafetyPage.tsx"
        }
        overwrite: true
      }
    }
