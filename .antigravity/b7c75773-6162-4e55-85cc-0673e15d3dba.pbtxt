    }
    use_fast_apply: true
    description: "Create SenderDashboard with overview stats, 6-step BookingWizard, My Parcels, Track Parcel, Payments, Disputes, Profile, and Deliver activity switcher in src/pages/SenderDashboard.tsx"
    diff_stats {
