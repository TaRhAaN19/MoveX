    tool_calls {
      id: "call_8903801077053035511"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import axios from \'axios\';\\n\\nexport const api = axios.create({\\n  baseURL: \'/api\',\\n  timeout: 15000\\n});\\n\\napi.interceptors.request.use((config) => {\\n  const token = localStorage.getItem(\'movex_token\');\\n  if (token) {\\n    config.headers.Authorization = `Bearer ${token}`;\\n  }\\n  return config;\\n});\\n\\nexport function getApiError(err: unknown, fallback = \'Something went wrong. Please try again.\'): string {\\n  if (axios.isAxiosError(err)) {\\n    const data = err.response?.data as { error?: string; message?: string } | undefined;\\n    if (data?.error) return data.error;\\n    if (data?.message) return data.message;\\n  }\\n  if (err instanceof Error && err.message) return err.message;\\n  return fallback;\\n}\\n\", \"Description\":\"Create centralized Axios API client with JWT token interceptor in src/services/api.ts\", \"Overwrite\":true, \"TargetFile\":\"/src/services/api.ts\", \"toolAction\":\"Creating Axios API service\", \"toolSummary\":\"Create Axios API service\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_8903801077053038284"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { createContext, useCallback, useContext, useEffect, useState } from \'react\';\\nimport { api } from \'../services/api\';\\nimport type { PartnerProfile, TransportMode, User } from \'../types/movex\';\\n\\nexport type ActivityView = \'sender\' | \'partner\' | \'admin\';\\n\\ninterface AuthContextValue {\\n  user: User | null;\\n  partnerProfile: PartnerProfile | null;\\n  activeActivity: ActivityView;\\n  loading: boolean;\\n  login: (email: string, password: string) => Promise<User>;\\n  register: (payload: {\\n    name: string;\\n    email: string;\\n    mobile: string;\\n    password: string;\\n    role: \'sender\' | \'partner\';\\n    primaryMode?: TransportMode;\\n    vehicleNumber?: string;\\n  }) => Promise<User>;\\n  logout: () => void;\\n  switchActivity: (target: \'sender\' | \'partner\') => Promise<void>;\\n  refreshMe: () => Promise<void>;\\n  setActiveActivity: (activity: ActivityView) => void;\\n}\\n\\nconst AuthContext = createContext<AuthContextValue | null>(null);\\n\\nexport function AuthProvider({ children }: { children: React.ReactNode }) {\\n  const [user, setUser] = useState<User | null>(null);\\n  const [partnerProfile, setPartnerProfile] = useState<PartnerProfile | null>(null);\\n  const [activeActivity, setActiveActivity] = useState<ActivityView>(() => {\\n    const saved = localStorage.getItem(\'movex_activity\');\\n    if (saved === \'partner\' || saved === \'admin\') return saved;\\n    return \'sender\';\\n  });\\n  const [loading, setLoading] = useState(true);\\n\\n  const refreshMe = useCallback(async () => {\\n    const token = localStorage.getItem(\'movex_token\');\\n    if (!token) {\\n      setUser(null);\\n      setPartnerProfile(null);\\n      setLoading(false);\\n      return;\\n    }\\n    try {\\n      const { data } = await api.get(\'/auth/me\');\\n      setUser(data.user);\\n      setPartnerProfile(data.partnerProfile || null);\\n      if (data.user.role === \'admin\') {\\n        setActiveActivity(\'admin\');\\n      } else if (data.user.role === \'partner\' && !localStorage.getItem(\'movex_activity\')) {\\n        setActiveActivity(\'partner\');\\n      }\\n    } catch {\\n      localStorage.removeItem(\'movex_token\');\\n      setUser(null);\\n      setPartnerProfile(null);\\n    } finally {\\n      setLoading(false);\\n    }\\n  }, []);\\n\\n  useEffect(() => {\\n    refreshMe();\\n  }, [refreshMe]);\\n\\n  const login = async (email: string, password: string): Promise<User> => {\\n    const { data } = await api.post(\'/auth/login\', { email, password });\\n    localStorage.setItem(\'movex_token\', data.token);\\n    setUser(data.user);\\n    setPartnerProfile(data.partnerProfile || null);\\n    const nextActivity: ActivityView =\\n      data.user.role === \'admin\' ? \'admin\' : data.user.role === \'partner\' ? \'partner\' : \'sender\';\\n    setActiveActivity(nextActivity);\\n    localStorage.setItem(\'movex_activity\', nextActivity);\\n    return data.user;\\n  };\\n\\n  const register = async (payload: {\\n    name: string;\\n    email: string;\\n    mobile: string;\\n    password: string;\\n    role: \'sender\' | \'partner\';\\n    primaryMode?: TransportMode;\\n    vehicleNumber?: string;\\n  }): Promise<User> => {\\n    const { data } = await api.post(\'/auth/register\', payload);\\n    localStorage.setItem(\'movex_token\', data.token);\\n    setUser(data.user);\\n    setPartnerProfile(data.partnerProfile || null);\\n    const nextActivity: ActivityView = data.user.role === \'partner\' ? \'partner\' : \'sender\';\\n    setActiveActivity(nextActivity);\\n    localStorage.setItem(\'movex_activity\', nextActivity);\\n    return data.user;\\n  };\\n\\n  const logout = () => {\\n    localStorage.removeItem(\'movex_token\');\\n    localStorage.removeItem(\'movex_activity\');\\n    setUser(null);\\n    setPartnerProfile(null);\\n    setActiveActivity(\'sender\');\\n  };\\n\\n  const switchActivity = async (target: \'sender\' | \'partner\') => {\\n    if (!user) return;\\n    if (user.role === \'admin\') return;\\n    const { data } = await api.post(\'/auth/switch-activity\', { targetActivity: target });\\n    setUser(data.user);\\n    setPartnerProfile(data.partnerProfile || null);\\n    setActiveActivity(target);\\n    localStorage.setItem(\'movex_activity\', target);\\n  };\\n\\n  return (\\n    <AuthContext.Provider\\n      value={{\\n        user,\\n        partnerProfile,\\n        activeActivity,\\n        loading,\\n        login,\\n        register,\\n        logout,\\n        switchActivity,\\n        refreshMe,\\n        setActiveActivity\\n      }}\\n    >\\n      {children}\\n    </AuthContext.Provider>\\n  );\\n}\\n\\nexport function useAuth() {\\n  const ctx = useContext(AuthContext);\\n  if (!ctx) throw new Error(\'useAuth must be used inside AuthProvider\');\\n  return ctx;\\n}\\n\", \"Description\":\"Create AuthContext with JWT login, registration, logout, and Sender/Partner activity switching in src/context/AuthContext.tsx\", \"Overwrite\":true, \"TargetFile\":\"/src/context/AuthContext.tsx\", \"toolAction\":\"Creating AuthContext provider\", \"toolSummary\":\"Create AuthContext provider\"}"
      original_name: "write_to_file"
    }
    thinking_duration {
      seconds: 19
      nanos: 374558471
    }
    stop_reason: STOP_REASON_STOP_PATTERN
    provider_assigned_message_id: "Sj_3ao35Esbg_uMPv52N2Q8"
  }
}
