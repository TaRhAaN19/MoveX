            }
            lines {
              text: "          <div className=\"flex items-center gap-2.5\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            <PackageCheck className=\"h-5 w-5 text-[#101114]\" />"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            <h3 className=\"font-display text-lg font-bold text-[#101114]\">Normal Packaging Supported</h3>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          </div>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          <p className=\"mt-2 text-sm leading-relaxed text-[#777777]\">"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "            Senders can use ordinary envelopes, paper wrapping, cloth bags, or standard cardboard boxes. MOVEX never forces proprietary packaging, physical QR stickers, special tamper seals, or mandatory central inspection hubs."
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "          </p>"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
