            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export const PROTOTYPE_MAX_WEIGHT_KG = 15.0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export function getParcelCategory(weightKg: number): \'XS\' | \'S\' | \'M\' | \'L\' | \'XL\' {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (weightKg <= 0.5) return \'XS\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (weightKg <= 2.0) return \'S\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (weightKg <= 5.0) return \'M\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (weightKg <= 10.0) return \'L\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return \'XL\';"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export function formatEtaLabel(minutes: number): string {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (minutes < 60) return `${minutes} mins`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const hrs = Math.floor(minutes / 60);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const mins = minutes % 60;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (mins === 0) return `${hrs} hr${hrs > 1 ? \'s\' : \'\'}`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return `${hrs} hr${hrs > 1 ? \'s\' : \'\'} ${mins} mins`;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export function getAllPricingConfigs(): PricingConfigRow[] {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return db.prepare(\'SELECT * FROM pricing_configs WHERE is_active = 1 ORDER BY base_fare ASC\').all() as PricingConfigRow[];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export function calculateModeQuote(input: PricingInput, config?: PricingConfigRow): PricingQuote {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const cfg = config || (db.prepare(\'SELECT * FROM pricing_configs WHERE mode = ?\').get(input.mode) as PricingConfigRow | undefined);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (!cfg) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    throw new Error(`Unsupported transportation mode: ${input.mode}`);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const incompatibilityReasons: string[] = [];"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const weight = Math.max(0.1, Number(input.weightKg) || 0.5);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const l = Math.max(1, Number(input.lengthCm) || 10);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const w = Math.max(1, Number(input.widthCm) || 10);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const h = Math.max(1, Number(input.heightCm) || 10);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const dist = Math.max(1, Number(input.distanceKm) || 5);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (weight > PROTOTYPE_MAX_WEIGHT_KG) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    incompatibilityReasons.push(`Exceeds prototype maximum limit of ${PROTOTYPE_MAX_WEIGHT_KG} kg.`);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (weight > cfg.max_weight_kg) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    incompatibilityReasons.push(`${cfg.display_name} supports up to ${cfg.max_weight_kg} kg.`);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (l > cfg.max_length_cm || w > cfg.max_width_cm || h > cfg.max_height_cm) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    incompatibilityReasons.push(`Dimensions exceed ${cfg.display_name} limit (${cfg.max_length_cm}\303\227${cfg.max_width_cm}\303\227${cfg.max_height_cm} cm).`);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Bike is optimal for local/regional routes (< 120 km)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (cfg.mode === \'bike\' && dist > 120) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    incompatibilityReasons.push(\'Bike delivery is limited to routes under 120 km.\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Flight is suited for long-distance corridors (> 150 km)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (cfg.mode === \'flight\' && dist < 120) {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    incompatibilityReasons.push(\'Flight mode is intended for intercity corridors over 120 km.\');"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const baseFare = round2(cfg.base_fare);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Distance charge scales with mode; long distance tiers keep bus/train competitive"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let effectivePerKm = cfg.per_km_rate;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (cfg.mode === \'bus\' && dist > 100) effectivePerKm = cfg.per_km_rate * 0.82;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (cfg.mode === \'train\' && dist > 150) effectivePerKm = cfg.per_km_rate * 0.78;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (cfg.mode === \'flight\' && dist > 300) effectivePerKm = cfg.per_km_rate * 0.85;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const distanceCharge = round2(dist * effectivePerKm);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Gradual weight charge that increases cleanly as weight increases"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const weightCharge = round2(weight * cfg.per_kg_rate);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Dimension / volumetric charge"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const volumeCm3 = l * w * h;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const volumetricKg = volumeCm3 / cfg.volumetric_divisor;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const excessVolKg = Math.max(0, volumetricKg - weight);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const dimensionCharge = round2("
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    (volumeCm3 / 4000) * (cfg.mode === \'freight\' ? 1.8 : 0.9) + excessVolKg * (cfg.mode === \'freight\' ? 8 : 4)"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  );"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Delivery model charge: Community Relay uses existing journeys (\342\202\2710 surcharge), Premium Express adds dedicated partner surcharge"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let modelCharge = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (input.deliveryModel === \'premium_express\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    modelCharge = round2(Math.max(35, Math.min(240, 30 + dist * 0.65)));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Urgency charge"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let urgencyCharge = 0;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (input.urgency === \'express\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    urgencyCharge = round2(20 + dist * 0.15);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  } else if (input.urgency === \'priority\') {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    urgencyCharge = round2(45 + dist * 0.25);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  }"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const subtotal = baseFare + distanceCharge + weightCharge + dimensionCharge + modelCharge + urgencyCharge;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const platformFee = round2(Math.max(5, Math.min(120, subtotal * 0.06)));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const totalPrice = round2(subtotal + platformFee);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // Partner receives 85% of subtotal; platform retains commission + fee"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const partnerEarning = round2(subtotal * 0.85);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const platformCommission = round2(totalPrice - partnerEarning);"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  // ETA calculation: mode speed + handover/terminal buffer + model/urgency adjustment"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const travelMins = (dist / cfg.avg_speed_kmh) * 60;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  let bufferMins = cfg.min_eta_mins * 0.5;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (cfg.mode === \'flight\') bufferMins = 75;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (cfg.mode === \'train\') bufferMins = 45;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (cfg.mode === \'bus\') bufferMins = 30;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (input.deliveryModel === \'premium_express\') bufferMins *= 0.65;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  if (input.urgency === \'priority\') bufferMins *= 0.75;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  else if (input.urgency === \'express\') bufferMins *= 0.88;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const etaMinutes = Math.max(18, Math.round(travelMins + bufferMins));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    mode: cfg.mode,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    displayName: cfg.display_name,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    compatible: incompatibilityReasons.length === 0,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    incompatibilityReasons,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    baseFare,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    distanceCharge,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    weightCharge,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    dimensionCharge,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    modelCharge,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    urgencyCharge,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    platformFee,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    totalPrice,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    partnerEarning,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    platformCommission,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    etaMinutes,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    etaLabel: formatEtaLabel(etaMinutes),"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    integrationStatus: cfg.integration_status,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    restrictionsSummary: cfg.restrictions_summary,"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    startingPrice: cfg.base_fare"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  };"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "export function calculateAllModeQuotes(input: Omit<PricingInput, \'mode\'>): PricingQuote[] {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const configs = getAllPricingConfigs();"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return configs.map((cfg) => calculateModeQuote({ ...input, mode: cfg.mode }, cfg));"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "}"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "function round2(n: number): number {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return Math.round(n * 100) / 100;"
