  planner_response {
    thinking: "**Developing Key Pages**\n\nI\'m currently focused on developing the `TrackParcelPage.tsx` and the `SenderDashboard.tsx` pages. Specifically, the tracking page needs to handle lookups by `parcel_code` (e.g., MVX-2026-100), and I\'m ensuring all necessary components are in place. The dashboard will provide a comprehensive view for senders. I\'m keen to ensure seamless interaction and data presentation.\n\n\n**Refining Tracking Page Data**\n\nI\'m now diving deep into the data display for the tracking page. I\'m focusing on the Digital Parcel Identity card, ensuring all key information like QR codes, unique IDs, booking timestamps, and status details are clearly presented. I\'m building out the timeline to include all 12 tracking statuses, custody history, and simulated GPS indicators, complete with route deviation alerts. I\'m also implementing the interactive map and OTP visibility. Finally, I\'ll be working on forms for mutual meeting point updates, and a dispute filing modal.\n\n\n"
    tool_calls {
      id: "call_3775179546370645236"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { useCallback, useEffect, useState } from \'react\';\\nimport { useNavigate, useParams } from \'react-router-dom\';\\nimport {\\n  AlertTriangle,\\n  CheckCircle2,\\n  Clock,\\n  MapPin,\\n  RefreshCw,\\n  Search,\\n  ShieldAlert,\\n  ShieldCheck\\n} from \'lucide-react\';\\nimport { QRCodeSVG } from \'qrcode.react\';\\nimport { api, getApiError } from \'../services/api\';\\nimport { useAuth } from \'../context/AuthContext\';\\nimport type { Booking, RouteResult } from \'../types/movex\';\\nimport MovexMap from \'../components/MovexMap\';\\nimport { formatStatusLabel, formatTransportModeLabel, getStatusToneClass } from \'../components/TransportIcon\';\\n\\nconst LIFECYCLE_STEPS = [\\n  \'CREATED\',\\n  \'DECLARED\',\\n  \'APPROVED\',\\n  \'MATCHING\',\\n  \'PARTNER_ASSIGNED\',\\n  \'PICKED_UP\',\\n  \'IN_TRANSIT\',\\n  \'HANDOVER_PENDING\',\\n  \'DELIVERED\'\\n];\\n\\nexport default function TrackParcelPage({ embeddedCode }: { embeddedCode?: string }) {\\n  const { code: routeCode } = useParams();\\n  const navigate = useNavigate();\\n  const { user } = useAuth();\\n\\n  const initialCode = embeddedCode || routeCode || \'MVX-2026-1001\';\\n  const [searchInput, setSearchInput] = useState(initialCode);\\n  const [booking, setBooking] = useState<Booking | null>(null);\\n  const [routeCoords, setRouteCoords] = useState<[number, number][]>([]);\\n  const [loading, setLoading] = useState(false);\\n  const [error, setError] = useState(\'\');\\n\\n  // Meeting point & dispute actions\\n  const [pickupMeetingInput, setPickupMeetingInput] = useState(\'\');\\n  const [dropoffMeetingInput, setDropoffMeetingInput] = useState(\'\');\\n  const [disputeReason, setDisputeReason] = useState(\'\');\\n  const [disputeDesc, setDisputeDesc] = useState(\'\');\\n  const [actionMessage, setActionMessage] = useState(\'\');\\n\\n  const fetchParcel = useCallback(async (targetCode: string) => {\\n    if (!targetCode.trim()) return;\\n    setLoading(true);\\n    setError(\'\');\\n    try {\\n      const { data } = await api.get<{ booking: Booking }>(`/bookings/${encodeURIComponent(targetCode.trim())}`);\\n      setBooking(data.booking);\\n      setPickupMeetingInput(data.booking.pickup_meeting_point || \'\');\\n      setDropoffMeetingInput(data.booking.dropoff_meeting_point || \'\');\\n\\n      const rRes = await api.post<{ route: RouteResult }>(\'/geo/route\', {\\n        pickupLat: data.booking.pickup_lat,\\n        pickupLng: data.booking.pickup_lng,\\n        destinationLat: data.booking.destination_lat,\\n        destinationLng: data.booking.destination_lng\\n      });\\n      setRouteCoords(rRes.data.route.coordinates);\\n    } catch (err) {\\n      setBooking(null);\\n      setError(getApiError(err, \'Parcel not found.\'));\\n    } finally {\\n      setLoading(false);\\n    }\\n  }, []);\\n\\n  useEffect(() => {\\n    const target = embeddedCode || routeCode || \'MVX-2026-1001\';\\n    setSearchInput(target);\\n    fetchParcel(target);\\n  }, [embeddedCode, routeCode, fetchParcel]);\\n\\n  const handleSearch = (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!searchInput.trim()) return;\\n    if (!embeddedCode) {\\n      navigate(`/track/${encodeURIComponent(searchInput.trim())}`);\\n    } else {\\n      fetchParcel(searchInput.trim());\\n    }\\n  };\\n\\n  const handleUpdateMeetingPoints = async () => {\\n    if (!booking) return;\\n    setActionMessage(\'\');\\n    try {\\n      const { data } = await api.post<{ booking: Booking }>(`/bookings/${booking.id}/meeting-point`, {\\n        pickupMeetingPoint: pickupMeetingInput,\\n        dropoffMeetingPoint: dropoffMeetingInput\\n      });\\n      setBooking(data.booking);\\n      setActionMessage(\'Meeting point preference updated.\');\\n    } catch (err) {\\n      setError(getApiError(err));\\n    }\\n  };\\n\\n  const handleRaiseDispute = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!booking) return;\\n    setActionMessage(\'\');\\n    try {\\n      const { data } = await api.post<{ booking: Booking }>(`/bookings/${booking.id}/dispute`, {\\n        reason: disputeReason,\\n        description: disputeDesc\\n      });\\n      setBooking(data.booking);\\n      setDisputeReason(\'\');\\n      setDisputeDesc(\'\');\\n      setActionMessage(\'Dispute submitted. Simulated payment placed ON HOLD for review.\');\\n    } catch (err) {\\n      setError(getApiError(err));\\n    }\\n  };\\n\\n  const handleCancelBooking = async () => {\\n    if (!booking) return;\\n    setActionMessage(\'\');\\n    try {\\n      const { data } = await api.post<{ booking: Booking; cancellationFee: number }>(`/bookings/${booking.id}/cancel`);\\n      setBooking(data.booking);\\n      setActionMessage(\\n        data.cancellationFee > 0\\n          ? `Booking cancelled. Simulated refund issued minus \342\202\271${data.cancellationFee} fee.`\\n          : \'Booking cancelled. Full simulated refund issued.\'\\n      );\\n    } catch (err) {\\n      setError(getApiError(err));\\n    }\\n  };\\n\\n  const isAuthorizedParty =\\n    user && booking && (user.id === booking.sender_id || user.id === booking.partner_id || user.role === \'admin\');\\n\\n  return (\\n    <div className={embeddedCode ? \'space-y-6\' : \'mx-auto max-w-6xl px-4 py-8 sm:px-6\'}>\\n      {/* Search Bar */}\\n      <form\\n        onSubmit={handleSearch}\\n        className=\\\"flex flex-col gap-3 rounded-2xl border border-neutral-200 bg-[#F5F5F5] p-4 sm:flex-row sm:items-center\\\"\\n      >\\n        <div className=\\\"flex flex-1 items-center gap-2 rounded-xl border border-neutral-200 bg-white px-3\\\">\\n          <Search className=\\\"h-4 w-4 text-[#777777]\\\" />\\n          <input\\n            type=\\\"text\\\"\\n            value={searchInput}\\n            onChange={(e) => setSearchInput(e.target.value)}\\n            placeholder=\\\"Enter Parcel ID (e.g. MVX-2026-1001)\\\"\\n            className=\\\"h-11 w-full font-mono-num text-sm text-[#101114] focus:outline-none\\\"\\n          />\\n        </div>\\n        <button\\n          type=\\\"submit\\\"\\n          className=\\\"h-11 rounded-xl bg-[#101114] px-5 text-sm font-semibold text-white hover:bg-[#25282D]\\\"\\n        >\\n          Track Parcel\\n        </button>\\n        {booking && (\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => fetchParcel(booking.parcel_code)}\\n            className=\\\"inline-flex h-11 items-center justify-center gap-1.5 rounded-xl border border-neutral-200 bg-white px-4 text-xs font-semibold text-[#101114] hover:bg-neutral-50\\\"\\n          >\\n            <RefreshCw className={`h-4 w-4 ${loading ? \'animate-spin\' : \'\'}`} />\\n            <span>Refresh</span>\\n          </button>\\n        )}\\n      </form>\\n\\n      {error && (\\n        <div className=\\\"mt-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700\\\">\\n          {error}\\n        </div>\\n      )}\\n\\n      {actionMessage && (\\n        <div className=\\\"mt-4 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm font-medium text-emerald-700\\\">\\n          {actionMessage}\\n        </div>\\n      )}\\n\\n      {booking && (\\n        <div className=\\\"mt-6 space-y-6\\\">\\n          {/* Route Deviation Alert */}\\n          {booking.route_deviation_alert === 1 && (\\n            <div className=\\\"flex items-center gap-3 rounded-2xl border border-amber-300 bg-amber-50 p-4 text-sm font-semibold text-amber-900\\\">\\n              <AlertTriangle className=\\\"h-5 w-5 shrink-0 text-amber-700\\\" />\\n              <span>\\n                Route Deviation Alert (Simulated GPS): Parcel telemetry deviated from the expected corridor. Review custody timeline below.\\n              </span>\\n            </div>\\n          )}\\n\\n          {/* Digital Parcel Identity Header */}\\n          <div className=\\\"grid grid-cols-1 gap-6 rounded-3xl border border-neutral-200 bg-white p-6 lg:grid-cols-12\\\">\\n            <div className=\\\"space-y-4 lg:col-span-8\\\">\\n              <div className=\\\"flex flex-wrap items-center justify-between gap-2\\\">\\n                <div>\\n                  <div className=\\\"text-xs font-semibold text-[#777777]\\\">Digital Parcel Identity</div>\\n                  <h1 className=\\\"font-display font-mono-num text-2xl font-extrabold text-[#101114]\\\">\\n                    {booking.parcel_code}\\n                  </h1>\\n                </div>\\n                <div className=\\\"text-right\\\">\\n                  <div className={`text-sm font-extrabold ${getStatusToneClass(booking.status)}`}>\\n                    {formatStatusLabel(booking.status)}\\n                  </div>\\n                  <div className=\\\"font-mono-num text-xs text-[#777777]\\\">\\n                    {new Date(booking.created_at).toLocaleString()}\\n                  </div>\\n                </div>\\n              </div>\\n\\n              <div className=\\\"grid grid-cols-1 gap-3 border-t border-neutral-200 pt-4 text-xs sm:grid-cols-3\\\">\\n                <div>\\n                  <div className=\\\"text-[#777777]\\\">Route</div>\\n                  <div className=\\\"mt-0.5 font-semibold text-[#101114]\\\">\\n                    {booking.pickup_location} \342\206\222 {booking.destination_location}\\n                  </div>\\n                </div>\\n                <div>\\n                  <div className=\\\"text-[#777777]\\\">Mode &amp; Model</div>\\n                  <div className=\\\"mt-0.5 font-semibold text-[#101114]\\\">\\n                    {formatTransportModeLabel(booking.transport_mode)} \302\267{\' \'}\\n                    {booking.delivery_model === \'community_relay\' ? \'Community Relay\' : \'Premium Express\'}\\n                  </div>\\n                </div>\\n                <div>\\n                  <div className=\\\"text-[#777777]\\\">Parcel Specs</div>\\n                  <div className=\\\"font-mono-num mt-0.5 font-semibold text-[#101114]\\\">\\n                    {booking.parcel_category} \302\267 {booking.weight_kg} kg \302\267 \342\202\271{booking.total_price.toFixed(2)}\\n                  </div>\\n                </div>\\n              </div>\\n\\n              <div className=\\\"grid grid-cols-1 gap-3 border-t border-neutral-200 pt-4 text-xs sm:grid-cols-2\\\">\\n                <div>\\n                  <div className=\\\"text-[#777777]\\\">Agreed Meeting Points</div>\\n                  <div className=\\\"mt-0.5 font-medium text-[#101114]\\\">\\n                    Pickup: {booking.pickup_meeting_point}\\n                  </div>\\n                  <div className=\\\"font-medium text-[#101114]\\\">\\n                    Drop-off: {booking.dropoff_meeting_point}\\n                  </div>\\n                </div>\\n                <div>\\n                  <div className=\\\"text-[#777777]\\\">MOVEX Guard &amp; Declaration</div>\\n                  <div className=\\\"mt-0.5 flex items-center gap-1.5 font-semibold text-[#101114]\\\">\\n                    {booking.guard_classification === \'PERMITTED\' ? (\\n                      <ShieldCheck className=\\\"h-4 w-4 text-emerald-700\\\" />\\n                    ) : (\\n                      <ShieldAlert className=\\\"h-4 w-4 text-amber-700\\\" />\\n                    )}\\n                    <span>{booking.guard_classification}</span>\\n                  </div>\\n                  <div className=\\\"text-[#777777]\\\">{booking.declared_contents}</div>\\n                </div>\\n              </div>\\n\\n              {/* OTPs for Authorized Sender / Partner */}\\n              {isAuthorizedParty && (\\n                <div className=\\\"grid grid-cols-3 gap-3 rounded-2xl bg-[#F5F5F5] p-4\\\">\\n                  <div>\\n                    <div className=\\\"text-[11px] font-medium text-[#777777]\\\">Pickup OTP</div>\\n                    <div className=\\\"font-mono-num text-lg font-extrabold text-[#101114]\\\">{booking.pickup_otp}</div>\\n                  </div>\\n                  <div>\\n                    <div className=\\\"text-[11px] font-medium text-[#777777]\\\">Handover OTP</div>\\n                    <div className=\\\"font-mono-num text-lg font-extrabold text-[#101114]\\\">{booking.handover_otp}</div>\\n                  </div>\\n                  <div>\\n                    <div className=\\\"text-[11px] font-medium text-[#777777]\\\">Delivery OTP</div>\\n                    <div className=\\\"font-mono-num text-lg font-extrabold text-[#101114]\\\">{booking.delivery_otp}</div>\\n                  </div>\\n                </div>\\n              )}\\n            </div>\\n\\n            <div className=\\\"flex flex-col items-center justify-center gap-3 rounded-2xl border border-neutral-200 bg-[#F5F5F5] p-5 lg:col-span-4\\\">\\n              <div className=\\\"rounded-xl bg-white p-3\\\">\\n                <QRCodeSVG value={`MOVEX:${booking.parcel_code}`} size={118} />\\n              </div>\\n              <div className=\\\"text-center text-xs text-[#777777]\\\">\\n                Digital QR Identity \302\267 Physical sticker not required\\n              </div>\\n              {booking.parcel_photo_url && (\\n                <img\\n                  src={booking.parcel_photo_url}\\n                  alt=\\\"Uploaded parcel\\\"\\n                  className=\\\"h-24 w-full rounded-xl object-cover\\\"\\n                />\\n              )}\\n            </div>\\n          </div>\\n\\n          {/* Lifecycle Progress Bar */}\\n          <div className=\\\"rounded-2xl border border-neutral-200 bg-white p-5\\\">\\n            <h2 className=\\\"font-display text-sm font-bold text-[#101114]\\\">Custody Stage</h2>\\n            <div className=\\\"mt-3 flex items-center gap-1.5 overflow-x-auto pb-1\\\">\\n              {LIFECYCLE_STEPS.map((st) => {\\n                const idx = LIFECYCLE_STEPS.indexOf(booking.status);\\n                const curIdx = LIFECYCLE_STEPS.indexOf(st);\\n                const reached = idx >= curIdx && idx !== -1;\\n                return (\\n                  <div\\n                    key={st}\\n                    className={`shrink-0 rounded-lg px-2.5 py-1.5 text-[11px] font-semibold whitespace-nowrap ${\\n                      booking.status === st\\n                        ? \'bg-[#FFD43B] text-[#101114]\'\\n                        : reached\\n                        ? \'bg-[#101114] text-white\'\\n                        : \'bg-[#F5F5F5] text-[#777777]\'\\n                    }`}\\n                  >\\n                    {formatStatusLabel(st)}\\n                  </div>\\n                );\\n              })}\\n            </div>\\n          </div>\\n\\n          {/* Map & Custody Timeline Split */}\\n          <div className=\\\"grid grid-cols-1 gap-6 lg:grid-cols-12\\\">\\n            <div className=\\\"lg:col-span-7\\\">\\n              <MovexMap\\n                pickupLocation={booking.pickup_location}\\n                pickupLatitude={booking.pickup_lat}\\n                pickupLongitude={booking.pickup_lng}\\n                destinationLocation={booking.destination_location}\\n                destinationLatitude={booking.destination_lat}\\n                destinationLongitude={booking.destination_lng}\\n                routeCoordinates={routeCoords}\\n                liveLat={booking.current_lat}\\n                liveLng={booking.current_lng}\\n                heightClass=\\\"h-80 md:h-96\\\"\\n              />\\n            </div>\\n\\n            <div className=\\\"rounded-3xl border border-neutral-200 bg-white p-5 lg:col-span-5\\\">\\n              <h2 className=\\\"font-display text-base font-bold text-[#101114]\\\">Custody &amp; Tracking Timeline</h2>\\n              <div className=\\\"mt-4 max-h-80 space-y-4 overflow-y-auto pr-1\\\">\\n                {(booking.trackingEvents || []).map((ev) => (\\n                  <div key={ev.id} className=\\\"flex gap-3 border-b border-neutral-100 pb-3 last:border-0\\\">\\n                    <div className=\\\"mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-[#F5F5F5] text-[#101114]\\\">\\n                      {ev.status === \'DELIVERED\' ? <CheckCircle2 className=\\\"h-4 w-4 text-emerald-700\\\" /> : <Clock className=\\\"h-4 w-4\\\" />}\\n                    </div>\\n                    <div className=\\\"min-w-0 flex-1\\\">\\n                      <div className=\\\"flex items-center justify-between gap-2\\\">\\n                        <span className=\\\"text-xs font-bold text-[#101114]\\\">{ev.title}</span>\\n                        <span className=\\\"font-mono-num text-[10px] text-[#777777]\\\">\\n                          {new Date(ev.created_at).toLocaleTimeString([], { hour: \'2-digit\', minute: \'2-digit\' })}\\n                        </span>\\n                      </div>\\n                      <p className=\\\"mt-0.5 text-xs text-[#777777]\\\">{ev.description}</p>\\n                      <div className=\\\"mt-1 text-[11px] font-medium text-[#777777]\\\">\\n                        {ev.actor_name} \302\267 {ev.location_name}\\n                        {ev.is_simulated_gps === 1 ? \' (Simulated GPS)\' : \'\'}\\n                      </div>\\n                    </div>\\n                  </div>\\n                ))}\\n              </div>\\n            </div>\\n          </div>\\n\\n          {/* Authorized Sender / Partner Actions */}\\n          {isAuthorizedParty && (\\n            <div className=\\\"grid grid-cols-1 gap-6 md:grid-cols-2\\\">\\n              {/* Mutual Meeting Point Coordination */}\\n              <div className=\\\"rounded-2xl border border-neutral-200 bg-white p-5\\\">\\n                <div className=\\\"flex items-center gap-2\\\">\\n                  <MapPin className=\\\"h-4 w-4 text-[#101114]\\\" />\\n                  <h3 className=\\\"font-display text-sm font-bold text-[#101114]\\\">\\n                    Mutual Meeting Point Coordination\\n                  </h3>\\n                </div>\\n                <div className=\\\"mt-3 space-y-3\\\">\\n                  <div>\\n                    <label className=\\\"mb-1 block text-xs font-medium text-[#777777]\\\">Pickup Point</label>\\n                    <input\\n                      type=\\\"text\\\"\\n                      value={pickupMeetingInput}\\n                      onChange={(e) => setPickupMeetingInput(e.target.value)}\\n                      className=\\\"h-10 w-full rounded-xl border border-neutral-200 bg-[#F5F5F5] px-3 text-xs text-[#101114]\\\"\\n                    />\\n                  </div>\\n                  <div>\\n                    <label className=\\\"mb-1 block text-xs font-medium text-[#777777]\\\">Drop-Off Point</label>\\n                    <input\\n                      type=\\\"text\\\"\\n                      value={dropoffMeetingInput}\\n                      onChange={(e) => setDropoffMeetingInput(e.target.value)}\\n                      className=\\\"h-10 w-full rounded-xl border border-neutral-200 bg-[#F5F5F5] px-3 text-xs text-[#101114]\\\"\\n                    />\\n                  </div>\\n                  <div className=\\\"flex flex-wrap items-center justify-between gap-2\\\">\\n                    <span className=\\\"text-[11px] text-[#777777]\\\">\\n                      Sender agreed: {booking.meeting_agreed_by_sender ? \'Yes\' : \'Pending\'} \302\267 Partner agreed:{\' \'}\\n                      {booking.meeting_agreed_by_partner ? \'Yes\' : \'Pending\'}\\n                    </span>\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={handleUpdateMeetingPoints}\\n                      className=\\\"h-9 rounded-xl bg-[#FFD43B] px-4 text-xs font-bold text-[#101114]\\\"\\n                    >\\n                      Save &amp; Agree\\n                    </button>\\n                  </div>\\n                </div>\\n              </div>\\n\\n              {/* Cancel / Dispute */}\\n              <div className=\\\"rounded-2xl border border-neutral-200 bg-white p-5\\\">\\n                <h3 className=\\\"font-display text-sm font-bold text-[#101114]\\\">Booking Actions &amp; Disputes</h3>\\n                {user?.id === booking.sender_id &&\\n                  ![\'PICKED_UP\', \'IN_TRANSIT\', \'DELIVERED\', \'CANCELLED\', \'REJECTED\'].includes(booking.status) && (\\n                    <div className=\\\"mt-3 border-b border-neutral-200 pb-4\\\">\\n                      <button\\n                        type=\\\"button\\\"\\n                        onClick={handleCancelBooking}\\n                        className=\\\"h-9 rounded-xl border border-red-300 bg-red-50 px-4 text-xs font-bold text-red-700 hover:bg-red-100\\\"\\n                      >\\n                        Cancel Booking (Simulated Refund)\\n                      </button>\\n                    </div>\\n                  )}\\n\\n                <form onSubmit={handleRaiseDispute} className=\\\"mt-3 space-y-2.5\\\">\\n                  <input\\n                    type=\\\"text\\\"\\n                    required\\n                    value={disputeReason}\\n                    onChange={(e) => setDisputeReason(e.target.value)}\\n                    placeholder=\\\"Dispute reason (e.g. Late arrival, Damaged packaging)\\\"\\n                    className=\\\"h-10 w-full rounded-xl border border-neutral-200 bg-[#F5F5F5] px-3 text-xs text-[#101114]\\\"\\n                  />\\n                  <input\\n                    type=\\\"text\\\"\\n                    required\\n                    value={disputeDesc}\\n                    onChange={(e) => setDisputeDesc(e.target.value)}\\n                    placeholder=\\\"Describe the issue for admin review\\\"\\n                    className=\\\"h-10 w-full rounded-xl border border-neutral-200 bg-[#F5F5F5] px-3 text-xs text-[#101114]\\\"\\n                  />\\n                  <button\\n                    type=\\\"submit\\\"\\n                    className=\\\"h-9 rounded-xl bg-[#101114] px-4 text-xs font-semibold text-white\\\"\\n                  >\\n                    Raise Dispute (Places Payment On Hold)\\n                  </button>\\n                </form>\\n              </div>\\n            </div>\\n          )}\\n        </div>\\n      )}\\n    </div>\\n  );\\n}\\n\", \"Description\":\"Create TrackParcelPage with Digital Parcel Identity QR, OTP display, 12-status timeline, Leaflet GPS map, and dispute/meeting-point actions in src/pages/TrackParcelPage.tsx\", \"Overwrite\":true, \"TargetFile\":\"/src/pages/TrackParcelPage.tsx\", \"toolAction\":\"Creating TrackParcelPage component\", \"toolSummary\":\"Create TrackParcelPage component\"}"
      thinking_signature: "\022\257\f\n\254\f\001i\024}\023\2748\226\230_\027j&$\235f\310Q\357j\243\360\326\230v\000\315IP\340\360\357w\252\216\313\211\226\250;\374K\363\332\3205\275\362\024\233\347\265d\254\204\243\242\254\351\034\356\204\t\377\302RlF\177h%C\354)\017\222o\227\371\035\373\215Q\240\241]6\252\346\347,\204!*b&\316IB\"\210\361\025o\2235y\271Hh\032\021&\261\303\a\222A\253!\220\371H7\273\250\237\331\335\305\336*.\037\266\037\252| \361\301\225\327Z\264\220\260\303\210s\3105v\367\273U\217dX\ry\302\334\341\032h\277x\v]\373\366\003\006\nE\342\325d\372a\304ku>\274\027\373\316\252\364\214u\v\332\307\375\376\255\302~\266\2218\316\243\330\273TP\341\356\337z\244\262{\t\370\372\202aj\370\220%\361D\317\342`3\3644\033\2102\246\223B.\277\223\271\3578d~\235\210$hI\375\246>\275\340|\227c\246^\005m\f\347\276l\362_mq8\327O\036\2466\350\207\a1\004!\274\000\260mL\315\035\225\\\006\024U\265\365\307\v\270\304\036\234~\v(\2443\3300\241\234=\3520-:y2+\302\273J\211\034x\bD\vNS\271\273)\326E\223@gW\220\'D\371\211]s\255`\277\2311\002F\022\373\273y\222y\310_\033\372\236$<\275&i\244\200\\\264\236\031X\006&\243\231+G\360\fR\t1F\022\351\027;\344\370}\234\255\315\322\306V7\244\206(\253\367\3416\314\347\207z\rS\316!P\267\310\232\2709\031\247.,\334w\020l\271eQ\310\237\304\236=3\333\315.\223T\356g\006AN\b}\346I\017\250b\203^z\037\272}\262\t\355\227\263\365\355\203\305\366qu\372\243V\221&e>\r\031\303>\341E\322c\321\302\212\266\254\rl\225\005\311\371g0\026h\370\314\030\201\002\370\246\220\b\344o Q\317yX\027H\f\257\342\307\217\217\234o\304Q\332`U\271K\230@\355\026\336\005/\322\030f\222\306\bm\344\345\343\244\312\221\304\037\\QfJ\1779\254q\377\230&\330\\\374\210mN\210\022\230\364\322\306\237\342\023\370\210\212\024c\r\307B\250\307|\374\336\026\016N)\025:\240\352/3\204\256\227\177\225u\177\032\355kX\377\231?\223r\253\221\201,\310\236v\345.\275\035\033u<\324<-\177:p\350\020\224b6\231Us\310f\025\277\371\304,\237P3\343G\261-\v\003\021\024Qq\346\307\374\346k\254\304\023\2358\326\217\375]\315\312\335\002\242\206\030\205|B\021\235\200\300\377\036\336G\024(Mg\221\261<\267\371\356\226\2414\005\200O,\311\031`{\277\350 \245\254\365\360\267\321\305z\t\035\336\345%\301\224\030*n\210\361NG\315\316\024K\370\225Hh\032D\227\364\025F\341\200L\322\002he\211z\333\356P\326\203\'\350\252\205\306\330xh2+@\344\005\234\264\022\216\004Z\305Dl\346\222\247D\233\035\372\300\030\n\305s\357 \\q\271\202\201\313p\020\311V\274\353\216.\r\3169\220\366\366V\205\273}.\026\315]\2166ZA\244\3274\227z\016!\362\311 O\023\213A\236i2\310\036\255\356n\360\001b\304\001\361y:\026\357\017\313\330\256\236\220\275-\213\233Q\f\250U\021\021\002.\003}\352\335}\242\313\301$\274A\320I!\323{\033\217(\264\'\211e\356B\270\247p\375\223R\'0>\327\202C\260T\023\362\332L~\242\251Yo\036\026\265l\360+\352\355&(\231\375P#4\3279x\202\213i\201\217R\335\365\377\005I\241\366\211\221Bv\302B3\371#\340`~\201\275\264\361\262\016\310\033\335\342\355N\261\267\333\243\303\017;\376\364\3315;\034\020QF\022\366\277\361\260\215\2407Mx\374L\026\332\245\235\326\223d\2713\223@AQ\300\016\246/\366\263\234\332\336m#\331mxy\222\276\335\241\317BC\236\367^\017e{?\203p\033u\025\016\"\354V\031\334\271\365U\252m\252!{,\271\206t\f\n\t{\003O~\243\262J\267o\260\232\362\220\316\341\344\225_\204\331\031/\341\204/\275\341\221\225Z\227\304\220Cmw\245\215\263\265\240K\362\254\350\037\0379\265\0265\203\271\205\251n_*\322 \243\220b\"\366\375\a\377.N2~Q\375\302%\341\247<\231\352\266+#\250\373S\032\017\223\265\205$ct\230\020\265\343qY\236\357S;NC\272\301\211b\vA;E\023/FV\367C\324\245\214\330\265\201?\277<\t\327\002\003\3063J\2347\312\211\277#\363\n\rk\226\033\231\247\020\322&\371f\323\200%RX,\260\022\037\357\244,j,\277\222\251 \253\355\300\026\203\245\274\224ay\247\316\026\377\226\241l[|y\264B\274\223(\264\327\204#\271g#\316(&\230\021;D.\350\233:\017d\017\033a\330\253\244uZ\340\333U\240F\033\265O\347\203\003\037\267\334\177U\300\024a\024\033\255YkE\201B\232C\027\325D\211\262\325\236\021e\036\200&\262W\210\377y\266\000\327$0[\263\360\235\237\200\362\277\302\352S{\227bbQz\227\272\277\354W%y\332\223\377\272\273\337\235\346s\263&8\350\310b|\000\204\340\333\274\317u\217\221\031\332\371Z\355\016=\034\217\207\263KH\377\321r\241\035\256hW\324\202\230?\016\244\377\301<\264\246[4\216\235\371_\237\225\030\027\276\362\003G<\032\335\201\370)6r1<\203\236\233\021\302K\257\376\272\231\266v\264\270\347\333\177\3037S}\236\353\267\221\212\201\371\264aY\027\v7T3\023=}\306\331%\370P\374|\214\002*o\376\032yT\254O5\023I\273\315x\036\331hx\272\350\345\023*&\275.\231_x\310\276/\304\017M\332\313?\253,o\331\2623p\016@\035\344x"
