      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import { Bike, Bus, Car, Plane, Train, Truck } from \'lucide-react\';\\nimport type { TransportMode } from \'../types/movex\';\\n\\nexport function TransportModeIcon({ mode, className = \'h-5 w-5\' }: { mode: TransportMode | string; className?: string }) {\\n  switch (mode) {\\n    case \'bike\':\\n      return <Bike className={className} />;\\n    case \'car\':\\n      return <Car className={className} />;\\n    case \'bus\':\\n      return <Bus className={className} />;\\n    case \'train\':\\n      return <Train className={className} />;\\n    case \'flight\':\\n      return <Plane className={className} />;\\n    case \'freight\':\\n      return <Truck className={className} />;\\n    default:\\n      return <Bike className={className} />;\\n  }\\n}\\n\\nexport function formatTransportModeLabel(mode: TransportMode | string): string {\\n  switch (mode) {\\n    case \'bike\':\\n      return \'Bike\';\\n    case \'car\':\\n      return \'Car\';\\n    case \'bus\':\\n      return \'Bus\';\\n    case \'train\':\\n      return \'Train\';\\n    case \'flight\':\\n      return \'Flight\';\\n    case \'freight\':\\n      return \'Commercial Freight\';\\n    default:\\n      return mode;\\n  }\\n}\\n\\nexport function formatStatusLabel(status: string): string {\\n  return status.replace(/_/g, \' \');\\n}\\n\\nexport function getStatusToneClass(status: string): string {\\n  switch (status) {\\n    case \'DELIVERED\':\\n    case \'APPROVED\':\\n    case \'COMPLETED\':\\n    case \'VERIFIED\':\\n    case \'PERMITTED\':\\n      return \'text-emerald-700\';\\n    case \'IN_TRANSIT\':\\n    case \'PICKED_UP\':\\n    case \'PARTNER_ASSIGNED\':\\n    case \'MATCHING\':\\n      return \'text-[#101114]\';\\n    case \'DECLARED\':\\n    case \'HANDOVER_PENDING\':\\n    case \'ON_HOLD\':\\n    case \'RESTRICTED\':\\n    case \'PENDING\':\\n      return \'text-amber-700\';\\n    case \'REJECTED\':\\n    case \'DISPUTED\':\\n    case \'CANCELLED\':\\n    case \'PROHIBITED\':\\n    case \'SUSPENDED\':\\n      return \'text-red-700\';\\n    default:\\n      return \'text-[#777777]\';\\n  }\\n}\\n\", \"Description\":\"Create TransportModeIcon and status formatting helpers in src/components/TransportIcon.tsx\", \"Overwrite\":true, \"TargetFile\":\"/src/components/TransportIcon.tsx\", \"toolAction\":\"Creating TransportIcon helpers\", \"toolSummary\":\"Create TransportIcon helpers\"}"
      original_name: "write_to_file"
    }
